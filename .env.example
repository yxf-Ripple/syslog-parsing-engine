# LLM 语义标注服务配置（示例模板）
# 复制为 .env 后按实际环境填写；.env 已被 .gitignore 忽略，勿提交真实配置。
# 注意：LLM 仅在离线学习阶段使用，在线转化（python -m src.main）不依赖 LLM。

# 是否启用 LLM 标注
LLM_ENABLED=true

# API 提供商 (openai_compatible / openai)
LLM_PROVIDER=openai_compatible

# API 地址（本地 LLM 网关，替换为实际主机地址）
LLM_BASE_URL=http://<llm-gateway-host>:9901/v1

# API 密钥（网关免鉴权可留空）
LLM_API_KEY=

# 模型名称
LLM_MODEL=qwen3

# 触发标注的最小时间间隔（分钟，0=仅按样例数触发）
LLM_TRIGGER_TIME_MINUTES=0

# LLM 温度参数
LLM_TEMPERATURE=0.1

# LLM 最大 token 数
LLM_MAX_TOKENS=4096

# LLM 标注冷却时间（秒）
LLM_ANNOTATION_COOLDOWN=5

# 自动离线学习开关
LLM_TRIGGER_ENABLED=false
# 未匹配样本达到多少条触发自动离线学习
LLM_TRIGGER_SAMPLE_COUNT=200
# 未匹配停止增长多少秒后也触发自动离线学习
LLM_TRIGGER_IDLE_SECONDS=3

# LLM 请求超时（秒）
LLM_TIMEOUT=120
